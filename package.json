{
  "name": "macro-evidence-website",
  "version": "0.1.0",
  "private": true,
  "description": "Source for the official Macro Evidence organization website.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.20.0",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build": "npm run verify:source && npm run verify:assets && astro check && astro build && npm run copy:licenses && npm run verify:dist",
    "preview": "astro preview",
    "release:verify": "npm run build && npm audit --audit-level=moderate",
    "copy:licenses": "node scripts/copy-license-files.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
