{
  "name": "macro-evidence-website",
  "version": "0.1.0",
  "private": true,
  "description": "Source for the official Macro Evidence organization website.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.21.0",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build": "npm run format:check && npm run lint && npm run verify:source && npm run verify:assets && astro check && astro build && npm run copy:licenses && npm run verify:dist",
    "preview": "astro preview",
    "release:verify": "npm run build && npm audit --omit=dev --audit-level=moderate",
    "copy:licenses": "node scripts/copy-license-files.mjs",
    "format": "prettier --write src/**/*.{astro,css,ts,js} public/**/*.js scripts/**/*.mjs *.{mjs,json,jsonc} .github/**/*.{yml,yaml}",
    "format:check": "prettier --check src/**/*.{astro,css,ts,js} public/**/*.js scripts/**/*.mjs *.{mjs,json,jsonc} .github/**/*.{yml,yaml}",
    "lint": "npm run lint:code && npm run lint:markdown",
    "lint:code": "eslint \"src/**/*.astro\" \"public/**/*.js\" \"scripts/**/*.mjs\" \"*.mjs\"",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\""
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.12.0",
    "jsonc-parser": "3.3.1",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.7.1"
    }
  }
}
