---
interface Props {
  mode?: 'inline' | 'popover';
}

const { mode = 'popover' } = Astro.props;
---

<details class:list={['theme-control', `theme-control-${mode}`]}>
  <summary>
    <span>Theme</span>
    <svg
      class="disclosure-chevron"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 3.5 4.5 4.5L6 12.5"></path>
    </svg>
  </summary>

  <div class="theme-options" role="group" aria-label="Theme preference">
    <button type="button" data-theme-choice="system" aria-pressed="false">
      <span>System</span>
      <span class="theme-check" aria-hidden="true">✓</span>
    </button>
    <button type="button" data-theme-choice="light" aria-pressed="false">
      <span>Light</span>
      <span class="theme-check" aria-hidden="true">✓</span>
    </button>
    <button type="button" data-theme-choice="dark" aria-pressed="false">
      <span>Dark</span>
      <span class="theme-check" aria-hidden="true">✓</span>
    </button>
  </div>
</details>

<style>
  .theme-control {
    position: relative;
    color: var(--color-white);
  }

  .theme-control summary {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: 0.65rem;
    cursor: pointer;
    list-style: none;
    border-radius: 0.45rem;
    color: rgba(248, 250, 252, 0.78);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .theme-control summary::-webkit-details-marker {
    display: none;
  }

  .disclosure-chevron {
    flex: 0 0 auto;
    transition: transform 150ms ease;
  }

  .theme-control-inline[open] .disclosure-chevron {
    transform: rotate(90deg);
  }

  .theme-control-popover[open] .disclosure-chevron {
    transform: rotate(-90deg);
  }

  .theme-options {
    display: grid;
    gap: 0.25rem;
  }

  .theme-options button {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.65rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: rgba(248, 250, 252, 0.82);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: left;
  }

  .theme-check {
    visibility: hidden;
    font-size: 0.95rem;
    line-height: 1;
  }

  .theme-options button[aria-pressed='true'] {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-white);
    font-weight: 750;
  }

  .theme-options button[aria-pressed='true'] .theme-check {
    visibility: visible;
  }

  .theme-control summary:focus-visible,
  .theme-options button:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  .theme-control-inline {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .theme-control-inline summary {
    color: var(--color-white);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
  }

  .theme-control-inline .theme-options {
    padding: 0.2rem 0 0.45rem 0.65rem;
  }

  .theme-control-popover summary {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 0.55rem;
    background: transparent;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .theme-control-popover[open] summary {
    border-color: rgba(255, 255, 255, 0.48);
    background: rgba(255, 255, 255, 0.06);
  }

  .theme-control-popover .theme-options {
    position: absolute;
    z-index: 10;
    right: 0;
    bottom: calc(100% + 0.45rem);
    width: 100%;
    padding: 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.65rem;
    background: var(--color-primary-deep);
    box-shadow: 0 1rem 2.5rem rgba(5, 8, 22, 0.24);
  }

  .theme-control summary:active,
  .theme-options button:active {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
  }

  .theme-control-popover summary:active {
    border-color: rgba(255, 255, 255, 0.62);
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-control summary:hover,
    .theme-options button:hover {
      background: rgba(255, 255, 255, 0.08);
      color: var(--color-white);
    }

    .theme-control-popover summary:hover {
      border-color: rgba(255, 255, 255, 0.5);
    }
  }
</style>
