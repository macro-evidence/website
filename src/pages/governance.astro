---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import PublicRecordCard from '../components/PublicRecordCard.astro';
---

<Layout
  title="Governance | Macro Evidence"
  description="How Macro Evidence evaluates, records, and publishes material organizational and technical decisions."
>
  <PageIntro
    kicker="Public governance"
    title="Decisions that matter should leave a record."
    lead="We use public governance and versioned decision records to keep material organizational and technical choices explicit, inspectable, and maintainable over time."
  />

  <section class="section records-section">
    <div class="site-container">
      <div class="split">
        <div>
          <span class="eyebrow">Public governance map</span>
          <h2>Read the records at their canonical source.</h2>
        </div>
        <div>
          <p class="section-intro">
            Cross-cutting organizational policy is owned by the governance
            repository. These cards link to the current records instead of
            copying them.
          </p>
        </div>
      </div>

      <div class="record-grid mt-3">
        <PublicRecordCard
          kicker="Direction"
          title="Organization & Platform Charter"
          description="Mission, vision, organization/platform scope, and durable direction."
          href="https://github.com/macro-evidence/governance/blob/main/ORGANIZATION_CHARTER.md"
          linkLabel="Read Organization & Platform Charter"
        />
        <PublicRecordCard
          kicker="Decision process"
          title="Governance & Decision-Making Charter"
          description="How organization-wide decisions are evaluated, recorded, and approved."
          href="https://github.com/macro-evidence/governance/blob/main/GOVERNANCE.md"
          linkLabel="Read Governance & Decision-Making Charter"
        />
        <PublicRecordCard
          kicker="Standards"
          title="Documentation Standards"
          description="Documentation ownership, writing, naming, and commit conventions."
          href="https://github.com/macro-evidence/governance/blob/main/DOCUMENTATION_STANDARDS.md"
          linkLabel="Read Documentation Standards"
        />
        <PublicRecordCard
          kicker="Participation"
          title="Contribution Policy"
          description="Participation, acceptance, contributor-rights, and stewardship boundaries."
          href="https://github.com/macro-evidence/governance/blob/main/CONTRIBUTION_POLICY.md"
          linkLabel="Read Contribution Policy"
        />
        <PublicRecordCard
          kicker="Identity"
          title="Trademarks Policy"
          description="Names, marks, official identity, and separation from repository licensing."
          href="https://github.com/macro-evidence/governance/blob/main/TRADEMARKS.md"
          linkLabel="Read Trademarks Policy"
        />
        <PublicRecordCard
          kicker="Decision records"
          title="Organization decision records"
          description="Cross-cutting decisions whose rationale and status should remain inspectable over time."
          href="https://github.com/macro-evidence/governance/tree/main/decisions"
          linkLabel="Browse organization decision records"
        />
      </div>
    </div>
  </section>

  <section class="section relationship-section">
    <div class="site-container split">
      <div>
        <span class="eyebrow">Authority boundary</span>
        <h2>Each subject has one canonical home.</h2>
      </div>
      <div class="reading">
        <p>
          <strong>Repository-specific architecture and decisions</strong> stay with
          the repository they govern.
        </p>
        <p>
          <strong
            >Organization-wide governance policy and cross-cutting decisions</strong
          > stay in the public governance repository.
        </p>
        <p>
          <strong
            >Organization-wide GitHub contribution guidance, security policy,
            and community-health files</strong
          > are maintained in macro-evidence/.github.
        </p>
        <div class="reference-links">
          <a
            class="text-link"
            href="https://github.com/orgs/macro-evidence/repositories"
          >
            Browse repositories on GitHub →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
