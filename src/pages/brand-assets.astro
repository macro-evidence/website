---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout
  title="Brand assets | Macro Evidence"
  description="Official Macro Evidence marks and lockups, approved production downloads, and concise identity-use guidance."
>
  <PageIntro
    kicker="Brand assets"
    title="Use the official identity files."
    lead="Download approved Macro Evidence marks and lockups, preserve their geometry, and use them in ways that do not create confusion about official status, affiliation, or endorsement."
  />

  <section class="section">
    <div class="site-container">
      <div class="section-lead-grid">
        <div>
          <span class="eyebrow">Standalone mark</span>
          <h2>Macro Evidence mark</h2>
        </div>
        <div class="reading">
          <p class="section-intro">
            Use the standalone mark when the surrounding context already
            identifies Macro Evidence. Use the supplied files rather than
            redrawing or reconstructing the artwork.
          </p>
        </div>
      </div>

      <div class="asset-grid asset-grid-variants mt-3">
        <article class="asset-card">
          <div class="asset-preview asset-preview-blue">
            <img
              src="/assets/brand/downloads/macro-evidence_mark-white_v1.svg"
              alt="Macro Evidence standalone mark in white"
              width="512"
              height="512"
            />
          </div>
          <div class="asset-copy">
            <h3>White reverse</h3>
            <p>For the primary #245B8A field or other approved dark fields.</p>
            <div class="asset-links">
              <a
                href="/assets/brand/downloads/macro-evidence_mark-white_v1.svg"
                download>SVG</a
              >
              <a
                href="/assets/brand/downloads/macro-evidence_mark-white_1024px_v1.png"
                download>PNG</a
              >
            </div>
          </div>
        </article>

        <article class="asset-card">
          <div class="asset-preview asset-preview-light">
            <img
              src="/assets/brand/downloads/macro-evidence_mark-primary_v1.svg"
              alt="Macro Evidence standalone primary mark"
              width="512"
              height="512"
            />
          </div>
          <div class="asset-copy">
            <h3>Primary</h3>
            <p>For light or white fields.</p>
            <div class="asset-links">
              <a
                href="/assets/brand/downloads/macro-evidence_mark-primary_v1.svg"
                download>SVG</a
              >
              <a
                href="/assets/brand/downloads/macro-evidence_mark-primary_1024px_v1.png"
                download>PNG</a
              >
            </div>
          </div>
        </article>

        <article class="asset-card">
          <div class="asset-preview asset-preview-light">
            <img
              src="/assets/brand/downloads/macro-evidence_mark-black_v1.svg"
              alt="Macro Evidence standalone black mark"
              width="512"
              height="512"
            />
          </div>
          <div class="asset-copy">
            <h3>Black</h3>
            <p>
              For single-color or monochrome reproduction on light or white
              fields.
            </p>
            <div class="asset-links">
              <a
                href="/assets/brand/downloads/macro-evidence_mark-black_v1.svg"
                download>SVG</a
              >
              <a
                href="/assets/brand/downloads/macro-evidence_mark-black_1024px_v1.png"
                download>PNG</a
              >
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section records-section">
    <div class="site-container">
      <div class="section-lead-grid">
        <div>
          <span class="eyebrow">Organization lockup</span>
          <h2>Macro Evidence</h2>
        </div>
        <div class="reading">
          <p class="section-intro">
            Use the horizontal lockup when a surface needs to identify the
            organization without relying on nearby text. The supplied lockup
            files already include the approved outer clearspace.
          </p>
        </div>
      </div>

      <div class="asset-grid asset-grid-variants mt-3">
        <article class="asset-card">
          <div class="asset-preview asset-preview-blue asset-preview-lockup">
            <img
              src="/assets/brand/downloads/macro-evidence_lockup-horizontal-white_v1.svg"
              alt="Macro Evidence horizontal white reverse lockup"
              width="2476"
              height="737"
            />
          </div>
          <div class="asset-copy">
            <h3>White reverse</h3>
            <p>
              For the primary #245B8A field or other approved dark fields.
              Minimum rendered width: 160px.
            </p>
            <div class="asset-links">
              <a
                href="/assets/brand/downloads/macro-evidence_lockup-horizontal-white_v1.svg"
                download>SVG</a
              >
              <a
                href="/assets/brand/downloads/macro-evidence_lockup-horizontal-white_1280px-wide_v1.png"
                download
              >
                PNG
              </a>
            </div>
          </div>
        </article>

        <article class="asset-card">
          <div class="asset-preview asset-preview-light asset-preview-lockup">
            <img
              src="/assets/brand/downloads/macro-evidence_lockup-horizontal-primary_v1.svg"
              alt="Macro Evidence horizontal primary lockup"
              width="2476"
              height="737"
            />
          </div>
          <div class="asset-copy">
            <h3>Primary</h3>
            <p>For light or white fields. Minimum rendered width: 160px.</p>
            <div class="asset-links">
              <a
                href="/assets/brand/downloads/macro-evidence_lockup-horizontal-primary_v1.svg"
                download>SVG</a
              >
              <a
                href="/assets/brand/downloads/macro-evidence_lockup-horizontal-primary_1280px-wide_v1.png"
                download
              >
                PNG
              </a>
            </div>
          </div>
        </article>

        <article class="asset-card">
          <div class="asset-preview asset-preview-light asset-preview-lockup">
            <img
              src="/assets/brand/downloads/macro-evidence_lockup-horizontal-black_v1.svg"
              alt="Macro Evidence horizontal black lockup"
              width="2476"
              height="737"
            />
          </div>
          <div class="asset-copy">
            <h3>Black</h3>
            <p>
              For single-color or monochrome reproduction on light or white
              fields. Minimum rendered width: 160px.
            </p>
            <div class="asset-links">
              <a
                href="/assets/brand/downloads/macro-evidence_lockup-horizontal-black_v1.svg"
                download>SVG</a
              >
              <a
                href="/assets/brand/downloads/macro-evidence_lockup-horizontal-black_1280px-wide_v1.png"
                download
              >
                PNG
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container split">
      <div>
        <span class="eyebrow">Use with care</span>
        <h2>Open work does not mean open identity.</h2>
      </div>
      <div class="reading">
        <p>
          Repository licenses and trademark identity are separate. Downloading
          an asset does not create endorsement, affiliation, or permission to
          use Macro Evidence's identity as the primary identity of another
          project or organization.
        </p>
        <ul>
          <li>Preserve the supplied geometry, proportions, and clearspace.</li>
          <li>
            Do not rotate, distort, arbitrarily recolor, or add gradients,
            shadows, or multicolor treatments.
          </li>
          <li>
            Below the horizontal lockup's 160px minimum, use the standalone mark
            rather than compressing the signature.
          </li>
          <li>
            Use distinct naming and visual identity for forks and derivative
            projects.
          </li>
        </ul>
        <div class="reference-links">
          <a class="text-link" href="/trademarks"
            >Review the Trademarks Policy →</a
          >
          <a class="text-link" href="/licensing">Review website licensing →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
