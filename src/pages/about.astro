---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout
  title="About | Macro Evidence"
  description="Macro Evidence builds and stewards open macroeconomic data infrastructure, with Macro Data Observatory as its flagship and foundational platform."
>
  <PageIntro
    kicker="About us"
    title="Built for the infrastructure behind macroeconomic evidence."
    lead="We build open macroeconomic data infrastructure and steward the public systems around that work."
  />

  <section class="section">
    <div class="site-container split">
      <div>
        <span class="eyebrow">Mission</span>
        <blockquote class="quote-block">
          Macro Evidence builds open macroeconomic data infrastructure around
          provenance, validation, reproducibility, and transparency. It develops
          shared foundations, products, reference layers, and interfaces, each
          with clear canonical ownership.
        </blockquote>
      </div>
      <div>
        <span class="eyebrow">Vision</span>
        <blockquote class="quote-block">
          To become a lasting, trusted steward of open macroeconomic data
          infrastructure, built incrementally on evidence, one disciplined
          decision at a time.
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section records-section">
    <div class="site-container">
      <div class="split">
        <div>
          <span class="eyebrow">What we are</span>
          <h2>An organization built around open infrastructure.</h2>
        </div>
        <div>
          <p class="section-intro">
            The organization is deliberately broader than any one repository or
            product surface, while remaining anchored to macroeconomic data
            infrastructure.
          </p>
        </div>
      </div>

      <div class="identity-grid mt-3">
        <article class="identity-panel">
          <h3>Macro Evidence is</h3>
          <ul>
            <li>
              a software organization building open macroeconomic data
              infrastructure;
            </li>
            <li>committed to public-good, open-source stewardship;</li>
            <li>
              the organization that builds and stewards Macro Data Observatory;
            </li>
            <li>
              an organization that records relevant governance and architectural
              decisions publicly.
            </li>
          </ul>
        </article>
        <article class="identity-panel">
          <h3>Macro Evidence is not</h3>
          <ul>
            <li>interchangeable with Macro Data Observatory;</li>
            <li>a generic analytics vendor or data consultancy;</li>
            <li>a decision-advisory service;</li>
            <li>
              an audit, assurance, certification, accounting, or
              compliance-services provider.
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container split">
      <div>
        <span class="eyebrow">Stewardship</span>
        <h2>Open infrastructure is a long-term commitment.</h2>
      </div>
      <div class="reading">
        <p>
          Our institutional posture is public-good, open-source stewardship.
          Growth and sustainability should strengthen the durability and
          usefulness of the public core rather than depend on restricting
          legitimate use already granted under its public licenses.
        </p>
        <p>
          We use public governance, explicit contribution boundaries, and a
          shared platform architecture to keep that posture legible as the work
          evolves.
        </p>
        <div class="founder-note" id="founder">
          <p>
            <strong>Siddharth Chauhan</strong> is the founder of Macro Evidence and
            maintainer of Macro Data Observatory.
          </p>
          <p>
            <a class="text-link" href="https://siddharthchauhan.web.app/"
              >Visit personal website →</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
