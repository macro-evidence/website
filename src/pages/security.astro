---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout
  title="Security | Macro Evidence"
  description="Report a suspected security vulnerability affecting Macro Evidence privately and find the canonical organization Security Policy."
>
  <div class="policy-page">
    <PageIntro
      kicker="Security"
      title="Report a security issue privately."
      lead="If you believe you found a security issue in this website, another Macro Evidence public surface, or one of our repositories, report it privately rather than disclosing it in a public issue, discussion, or pull request."
    />

    <section class="section">
      <div class="site-container reading policy-reading-wide">
        <section>
          <h2>Report privately</h2>
          <p>
            For a suspected vulnerability affecting <strong
              >macro-evidence.com</strong
            > or another Macro Evidence public surface, email <a
              href="mailto:security@macro-evidence.com"
              >security@macro-evidence.com</a
            >.
          </p>
          <p>
            If the affected repository offers GitHub Private Vulnerability
            Reporting, you may instead use its
            <strong>Report a vulnerability</strong> workflow.
          </p>
        </section>

        <section>
          <h2>Protect sensitive material</h2>
          <p>
            Include enough information to identify and reproduce the issue where
            possible, but do not send credentials, private keys, access tokens,
            or other live secrets. Use the security email address first if
            sensitive material requires a coordinated transfer method.
          </p>
        </section>

        <section>
          <h2>Full policy</h2>
          <p>
            The organization-wide Security Policy is maintained in Macro
            Evidence's public <code>.github</code>{' '}repository.
          </p>
          <p>
            <a
              class="text-link"
              href="https://github.com/macro-evidence/.github/blob/main/SECURITY.md"
            >
              Read the full Security Policy on GitHub →
            </a>
          </p>
        </section>
      </div>
    </section>
  </div>
</Layout>
