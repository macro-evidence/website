---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout
  title="Privacy | Macro Evidence"
  description="How the Macro Evidence website minimizes visitor data collection, handles theme preferences, email contact, and external services."
>
  <div class="policy-page">
    <PageIntro
      kicker="Privacy"
      title="Less data, by design."
      lead="We keep this website intentionally simple: no advertising trackers, no website analytics beacon, and no contact form."
    />

    <section class="section">
      <div class="site-container reading">
        <section>
          <h2>Website delivery</h2>
          <p>
            The site is delivered through third-party hosting and network
            infrastructure. That provider may process technical request
            information needed to deliver, secure, and operate the service.
          </p>
        </section>
        <section>
          <h2>Theme preference</h2>
          <p>
            If you choose System, Light, or Dark, the site stores that
            preference locally in your browser so it can remember your choice.
            The preference is not sent to us or used for analytics or
            advertising.
          </p>
        </section>
        <section>
          <h2>Email contact</h2>
          <p>
            If you email Macro Evidence, your message and the information you
            choose to include are handled through our email service. Send only
            the information necessary for your inquiry.
          </p>
        </section>
        <section>
          <h2>External links</h2>
          <p>
            This website links to repositories, social platforms, and other
            external services. When you follow an external link, that service's
            own privacy and data-handling practices apply.
          </p>
        </section>
        <section>
          <h2>If this changes</h2>
          <p>
            If we later add analytics, forms, accounts, embedded third-party
            content, or other data-collecting functionality, this page will be
            reviewed and updated with that change.
          </p>
        </section>
      </div>
    </section>
  </div>
</Layout>
