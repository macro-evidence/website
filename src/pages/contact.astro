---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout
  title="Contact | Macro Evidence"
  description="Get in touch with Macro Evidence about collaboration, repository questions, security, sponsorship, or general inquiries."
>
  <PageIntro
    kicker="Contact"
    title="Get in touch."
    lead="Whether you want to ask a question, discuss collaboration, report a security issue, or talk about sponsorship, here is the best place to start."
  />

  <section class="section">
    <div class="site-container contact-grid">
      <article class="contact-path">
        <span class="micro-label">General</span>
        <h2>Questions and collaboration</h2>
        <p>For general questions, institutional inquiries, or collaboration.</p>
        <a class="text-link" href="mailto:hello@macro-evidence.com"
          >hello@macro-evidence.com</a
        >
      </article>

      <article class="contact-path">
        <span class="micro-label">Software</span>
        <h2>Repository questions</h2>
        <p>
          When a question belongs to a specific repository, use that
          repository's issue tracker and contribution or technical guidance
          where appropriate.
        </p>
        <a
          class="text-link"
          href="https://github.com/orgs/macro-evidence/repositories"
          >Browse repositories on GitHub →</a
        >
      </article>

      <article class="contact-path">
        <span class="micro-label">Security</span>
        <h2>Report a security issue</h2>
        <p>
          If you suspect a vulnerability, use our private reporting guidance
          before sharing details.
        </p>
        <a class="text-link" href="/security">Security guidance →</a>
      </article>

      <article class="contact-path">
        <span class="micro-label">Sponsorship</span>
        <h2>Sponsorship and billing</h2>
        <p>For sponsorship or billing questions.</p>
        <a class="text-link" href="mailto:billing@macro-evidence.com"
          >billing@macro-evidence.com</a
        >
      </article>
    </div>
  </section>
</Layout>
