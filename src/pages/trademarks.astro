---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout
  title="Trademarks | Macro Evidence"
  description="Macro Evidence identity-use orientation, public brand assets, and the canonical Trademarks Policy."
>
  <div class="policy-page">
    <PageIntro
      kicker="Trademarks"
      title="Open the work. Preserve the identity."
      lead="Open-source and open-content licenses grant real rights in the work they cover. They do not automatically grant the right to adopt Macro Evidence's names, marks, or visual identity as the identity of another project, product, service, or organization."
    />

    <section class="section">
      <div class="site-container reading policy-reading-wide">
        <section>
          <h2>Identity and licensing are separate</h2>
          <p>
            Repository and content licenses govern the code and text they cover.
            Macro Evidence names, marks, and official visual identity are
            governed separately by the Trademarks Policy and applicable law.
          </p>
        </section>

        <section>
          <h2>Official brand assets</h2>
          <p>
            Approved public-distribution identity files are available from the
            Brand assets page. The website licensing page explains the separate
            terms that apply to those identity assets, the site's Apache-2.0
            source, CC BY-SA 4.0 prose, and separately licensed third-party
            material.
          </p>
          <div class="reference-links">
            <a class="text-link" href="/brand-assets">View brand assets →</a>
            <a class="text-link" href="/licensing">Review website licensing →</a
            >
          </div>
        </section>

        <section>
          <h2>Full policy</h2>
          <p>
            The canonical Trademarks Policy contains the complete claimed-mark,
            factual-use, official-status, derivative, and identity-use rules.
          </p>
          <p>
            <a
              class="text-link"
              href="https://github.com/macro-evidence/governance/blob/main/TRADEMARKS.md"
            >
              Read the full Trademarks Policy on GitHub →
            </a>
          </p>
        </section>
      </div>
    </section>
  </div>
</Layout>
